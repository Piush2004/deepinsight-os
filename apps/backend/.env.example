POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=deepinsight
# api/core/config.py reads DATABASE_URL directly - it is NOT assembled from the
# POSTGRES_* values above (those are only used by docker-compose.yml to configure the
# Postgres container itself). Leaving this unset falls back to a local SQLite file,
# which this project's own rules treat as never a substitute for real verification -
# set it explicitly, matching whatever POSTGRES_* values you're actually running.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deepinsight
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_AUDIENCE=your-clerk-api-audience
ENCRYPTION_KEY=generate-a-real-fernet-key-for-this-value

# LLM (Ollama) - api/core/interfaces/llm_provider.py / api/services/llm/ollama_provider.py
# OLLAMA_MODEL must exactly match a tag already pulled on the target Ollama instance -
# run `ollama list` there and copy the NAME column exactly (e.g. "qwen2.5:3b-instruct",
# not just "qwen2.5" unless you've specifically pulled that bare/`:latest` tag). A
# mismatch here fails loudly with an actionable error listing what IS available -
# never guessed at automatically - see LLMModelNotFoundError.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Optional: only used if explicitly set. When set, generation automatically retries
# against this model if the primary OLLAMA_MODEL is unreachable OR not pulled.
OLLAMA_FALLBACK_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
